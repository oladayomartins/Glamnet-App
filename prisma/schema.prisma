// GLAMNET data model.
//
// PostgreSQL. The schema avoids vendor-specific constructs — enums are modelled
// as strings, money as integer pence — so it stays portable.
//
// Two URLs are needed on serverless hosts such as Vercel: `url` is the pooled
// connection every request uses (a lambda per request would otherwise exhaust
// Postgres connections), and `directUrl` is the unpooled one Prisma needs for
// migrations, which a transaction pooler cannot carry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A geographic Beauty Hub. Providers cover one or more sectors within a hub.
model Hub {
  id             String   @id @default(cuid())
  name           String
  /// Sector code shown on the provider broadcast, e.g. "S11".
  sector         String   @unique
  city           String
  /// Fixed travel fee for bookings in this sector, in pence.
  travelFeeMinor Int      @default(500)
  createdAt      DateTime @default(now())
  /// Centroid of the outward code, from the ONS postcode directory. Hubs are
  /// created on demand for any UK outward code.
  latitude       Float?
  longitude      Float?

  providers Provider[]
  bookings  Booking[]
}

/// A bookable base service or premium add-on.
model Service {
  id              String  @id @default(cuid())
  name            String
  description     String  @default("")
  /// Price in pence.
  priceMinor      Int
  durationMinutes Int
  /// "SERVICE" (base) or "ADDON" (premium add-on).
  kind            String  @default("SERVICE")
  category        String  @default("Hair")
  isActive        Boolean @default(true)
  /// Illustrative image for category tiles and search results.
  imageUrl        String  @default("")
  imageFileId     String  @default("")

  providers    ProviderService[]
  bookingItems BookingItem[]
}

/// Links a Supabase Auth user to their role and profile in this database.
///
/// Identity lives in Supabase `auth.users`; this table holds only what the
/// app needs to authorise a request. `authUserId` is the Supabase user id
/// (a uuid), and is the join between a session and everything below.
model AppUser {
  id              String    @id @default(cuid())
  /// Supabase auth.users.id. Unique so a session maps to exactly one profile.
  authUserId      String    @unique
  email           String    @unique
  /// "CUSTOMER" | "PROVIDER" | "ADMIN". Never settable from the client.
  role            String    @default("CUSTOMER")
  createdAt       DateTime  @default(now())
  /// Set by an admin to lock the account out. Checked on every request.
  suspendedAt     DateTime?
  suspendedReason String    @default("")

  customer Customer?
  provider Provider?

  @@index([role])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @default("")
  createdAt DateTime @default(now())

  /// Null for seeded demo records that have no login yet.
  appUserId String?  @unique
  appUser   AppUser? @relation(fields: [appUserId], references: [id])

  bookings Booking[]
}

model Provider {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  bio               String   @default("")
  rating            Float    @default(5)
  completedBookings Int      @default(0)
  isAcceptingWork   Boolean  @default(true)
  createdAt         DateTime @default(now())

  /// Profile photo in the media library. fileId is kept so the image can be
  /// deleted from ImageKit when it is replaced, rather than orphaned.
  avatarUrl    String @default("")
  avatarFileId String @default("")

  /// "PENDING" | "APPROVED" | "REJECTED" | "SUSPENDED" (spec: vetted
  /// marketplace). SUSPENDED is an approved vendor taken offline by an admin.
  /// Only APPROVED providers are eligible for broadcasts — enforced in the
  /// matching query, not just hidden in the UI.
  approvalStatus String    @default("PENDING")
  approvedAt     DateTime?
  approvalNote   String    @default("")

  appUserId String?  @unique
  appUser   AppUser? @relation(fields: [appUserId], references: [id])

  hubId String
  hub   Hub    @relation(fields: [hubId], references: [id])

  // --- Storefront (Open Marketplace Directory §B, §C) ---------------------
  /// Public storefront handle: glamnet.co/pro/:slug. Null until the vendor
  /// claims one in the onboarding wizard.
  slug             String?   @unique
  phone            String    @default("")
  instagramHandle  String    @default("")
  tiktokHandle     String    @default("")
  /// "HOME_SALON" | "PRIVATE_ROOM" | "CHAIR" | "MOBILE". Where clients come
  /// to; MOBILE vendors only travel.
  workspaceType    String    @default("MOBILE")
  /// Outward postcode sector of the workspace (e.g. "S10"), used for the
  /// directory's proximity sort. Empty falls back to the hub's sector.
  workspaceSector  String    @default("")
  /// Whether the vendor also travels to the client's address.
  travelsToClients Boolean   @default(true)
  /// The vendor's full base postcode and its coordinates. PRIVATE: used only
  /// for distance. Publicly a vendor is shown at their outward code.
  basePostcode     String    @default("")
  latitude         Float?
  longitude        Float?
  /// Set when the vendor finishes the onboarding wizard.
  onboardedAt      DateTime?
  /// is_verified: approved by an admin with compliance documents on file.
  /// Only verified vendors have a live storefront and booking calendar.
  isVerified       Boolean   @default(false)

  // --- Payouts (Stripe Connect Express) -----------------------------------
  stripeAccountId String  @default("")
  payoutsEnabled  Boolean @default(false)

  /// Promoted by an admin: listed first in the directory and on the home page.
  isFeatured Boolean @default(false)

  services     ProviderService[]
  availability ProviderAvailability[]
  timeOff      ProviderTimeOff[]
  bookings     Booking[]
  broadcasts   BookingBroadcast[]
  lookbook     ProviderLookbookImage[]
  documents    ProviderDocument[]

  @@index([hubId])
  @@index([approvalStatus])
}

/// Which services a provider is qualified to deliver, and at what price on
/// their own storefront.
model ProviderService {
  providerId      String
  serviceId       String
  /// The vendor's own price in pence; null uses the catalogue price. Only the
  /// storefront (direct) booking uses it — a broadcast is priced before any
  /// vendor is chosen, so it can only use the catalogue.
  priceMinor      Int?
  /// The vendor's own duration; null uses the catalogue duration.
  durationMinutes Int?
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
  @@index([serviceId])
}

/// One of up to three "look transformation" photos on a storefront.
model ProviderLookbookImage {
  id         String   @id @default(cuid())
  providerId String
  url        String
  fileId     String   @default("")
  caption    String   @default("")
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, position])
}

/// Insurance certificate or practitioner licence, uploaded for admin review.
model ProviderDocument {
  id         String    @id @default(cuid())
  providerId String
  /// "INSURANCE" | "LICENCE" | "CERTIFICATE".
  kind       String
  fileName   String    @default("")
  mimeType   String    @default("")
  url        String
  fileId     String    @default("")
  /// "PENDING" | "APPROVED" | "REJECTED".
  status     String    @default("PENDING")
  reviewNote String    @default("")
  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
}

/// A recurring weekly working window, in local wall-clock minutes from midnight.
model ProviderAvailability {
  id          String @id @default(cuid())
  providerId  String
  /// 0 = Sunday … 6 = Saturday, matching JavaScript's `Date#getDay`.
  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

/// A one-off blocked period (holiday, personal time, admin block).
model ProviderTimeOff {
  id         String   @id @default(cuid())
  providerId String
  startAt    DateTime
  endAt      DateTime
  reason     String   @default("Unavailable")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startAt])
}

/// Admin-configurable emergency commercial parameters (spec §5).
///
/// Rows are never edited in place: saving new settings inserts a new row with a
/// new `effectiveFrom`, so historic bookings remain explainable against the
/// config that priced them.
model EmergencyPricingConfig {
  id               String   @id @default(cuid())
  /// Notice period at or below which a booking is EMERGENCY. Default 720 (12h).
  thresholdMinutes Int      @default(720)
  /// "PERCENTAGE" or "FIXED".
  surchargeType    String   @default("PERCENTAGE")
  /// Basis points when PERCENTAGE, pence when FIXED.
  surchargeValue   Int      @default(2500)
  effectiveFrom    DateTime @default(now())
  isActive         Boolean  @default(true)
  note             String   @default("")
  createdAt        DateTime @default(now())

  @@index([isActive, effectiveFrom])
}

model Booking {
  id String @id @default(cuid())

  // --- Emergency classification (spec §9) ---------------------------------
  /// "NORMAL" or "EMERGENCY". Calculated server-side, stored permanently.
  bookingType          String   @default("NORMAL")
  bookingCreatedAt     DateTime @default(now())
  appointmentStartAt   DateTime
  /// appointmentStartAt - bookingCreatedAt, in whole minutes.
  noticePeriodMinutes  Int
  /// Threshold in force when this booking was classified, kept for audit.
  thresholdMinutesUsed Int      @default(720)

  // --- Duration -----------------------------------------------------------
  /// Billable service duration of the basket.
  serviceDurationMinutes  Int
  /// serviceDurationMinutes + the 15-minute transition period.
  reservedDurationMinutes Int
  /// appointmentStartAt + reservedDurationMinutes — the calendar lock (spec §2).
  reservedUntilAt         DateTime

  // --- Money, all in pence (spec §5) --------------------------------------
  subtotalMinor                  Int
  travelFeeMinor                 Int
  emergencySurchargeMinor        Int @default(0)
  otherSurchargesMinor           Int @default(0)
  trustFeeMinor                  Int @default(50)
  totalInvoicePriceMinor         Int
  providerEarningsMinor          Int @default(0)
  providerEmergencyEarningsMinor Int @default(0)

  // --- Lifecycle (spec §8) ------------------------------------------------
  status               String  @default("REQUESTED")
  sector               String
  referenceImageUrl    String  @default("")
  referenceImageFileId String  @default("")
  notes                String  @default("")
  addressLine          String  @default("")
  /// Revealed to the provider only at ADDRESS_UNLOCKED.
  addressUnlocked      Boolean @default(false)
  rating               Int?
  /// The customer's written review, kept beside the rating that released
  /// payment. Empty when they rated without writing anything.
  reviewNote           String  @default("")
  cancelledReason      String  @default("")

  // --- Origin & commission (Directory §D, dual-commission protocol) --------
  /// "BROADCAST" (emergency/request flow), "MARKETPLACE" (chosen on the
  /// directory) or "DIRECT_LINK" (the vendor's own /pro/:slug link).
  source                  String  @default("BROADCAST")
  /// "CUSTOMER_ADDRESS" (vendor travels) or "VENDOR_PREMISES".
  serviceLocation         String  @default("CUSTOMER_ADDRESS")
  /// Rule B: a new client found through the marketplace. Only ever true on
  /// the first booking between this customer and this vendor.
  firstDiscoveryBooking   Boolean @default(false)
  /// Marketplace commission applied, in basis points (0 or 3000).
  commissionBps           Int     @default(3000)
  /// Tip added at checkout. Always passed to the vendor in full.
  tipMinor                Int     @default(0)
  platformCommissionMinor Int     @default(0)
  /// Card processing fee deducted from the vendor's payout (Rule A only).
  processingFeeMinor      Int     @default(0)
  /// What the vendor receives at escrow release, tip included.
  providerPayoutMinor     Int     @default(0)

  // --- Escrow (Directory §D, Flow 2) ---------------------------------------
  /// "NOT_STARTED" | "PENDING_AUTHORISATION" | "AUTHORISED" |
  /// "ESCROW_RELEASED" | "VOIDED".
  paymentStatus         String    @default("NOT_STARTED")
  paymentIntentId       String    @default("")
  transferId            String    @default("")
  /// One-time 4-digit code shown only to the customer. Never returned to the
  /// vendor, who has to be told it in person.
  completionPin         String    @default("")
  completionPinIssuedAt DateTime?
  completionPinAttempts Int       @default(0)
  escrowReleasedAt      DateTime?
  /// escrowReleasedAt + 24h. After it, the booking is closed_uncontestable.
  disputeWindowClosesAt DateTime?
  /// "OPEN" | "DISPUTED" | "CLOSED_UNCONTESTABLE".
  settlementStatus      String    @default("OPEN")
  disputeReason         String    @default("")
  disputedAt            DateTime?

  // --- Promotions -------------------------------------------------------------
  /// Taken off what the customer is charged. Funded by GLAMNET: the vendor's
  /// payout is exactly what it would have been without the code.
  discountMinor Int        @default(0)
  promoCodeId   String?
  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id])

  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  hubId      String
  hub        Hub       @relation(fields: [hubId], references: [id])
  /// Set when a provider accepts the broadcast.
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  items            BookingItem[]
  broadcasts       BookingBroadcast[]
  events           BookingStatusEvent[]
  notifications    Notification[]
  completionPhotos BookingCompletionPhoto[]
  promoRedemption  PromoRedemption?

  @@index([status])
  @@index([bookingType])
  @@index([providerId, appointmentStartAt])
  @@index([appointmentStartAt])
  @@index([customerId, providerId])
  @@index([settlementStatus, disputeWindowClosesAt])
}

/// One of the three mandatory photos of the finished work, taken by the
/// vendor before the release PIN is issued — the visual audit trail a
/// dispute is judged against.
model BookingCompletionPhoto {
  id        String   @id @default(cuid())
  bookingId String
  url       String
  fileId    String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// A basket line, snapshotted at booking time so later price changes to the
/// Service catalogue never rewrite a historic invoice.
model BookingItem {
  id              String @id @default(cuid())
  bookingId       String
  serviceId       String
  name            String
  priceMinor      Int
  durationMinutes Int
  kind            String @default("SERVICE")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
}

/// One provider's invitation to accept a broadcast request (spec §6).
model BookingBroadcast {
  id                     String    @id @default(cuid())
  bookingId              String
  providerId             String
  sentAt                 DateTime  @default(now())
  expiresAt              DateTime
  /// "PENDING" | "ACCEPTED" | "DECLINED" | "LOST" | "EXPIRED".
  status                 String    @default("PENDING")
  respondedAt            DateTime?
  /// Earnings quoted to this provider, in pence.
  earningsMinor          Int       @default(0)
  emergencyEarningsMinor Int       @default(0)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, providerId])
  @@index([providerId, status])
}

/// Append-only lifecycle audit trail (spec §8).
model BookingStatusEvent {
  id         String   @id @default(cuid())
  bookingId  String
  fromStatus String?
  toStatus   String
  actor      String   @default("SYSTEM")
  note       String   @default("")
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

/// Outbound message record (spec §11). Persisted rather than pushed so the
/// emergency tag can be verified consistently across every channel.
model Notification {
  id          String    @id @default(cuid())
  bookingId   String
  /// "PROVIDER" | "CUSTOMER" | "ADMIN".
  audience    String
  /// Set when the notification targets one specific provider.
  providerId  String?
  /// "PUSH" | "EMAIL" | "IN_APP".
  channel     String    @default("PUSH")
  title       String
  body        String
  /// Mirrors the booking's classification so the tag is consistent everywhere.
  bookingType String    @default("NORMAL")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([audience, createdAt])
  @@index([providerId, createdAt])
}

// --- Admin console ---------------------------------------------------------

/// A Specialty Hub: a category of work. `name` is what Service.category holds,
/// so renaming one renames it on every service in the same transaction.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @unique
  emoji       String   @default("")
  blurb       String   @default("")
  imageUrl    String   @default("")
  imageFileId String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// A marketing campaign: an on-site announcement, an email, or both.
model Campaign {
  id          String    @id @default(cuid())
  name        String
  /// "ALL" | "CUSTOMERS" | "VENDORS".
  audience    String    @default("ALL")
  title       String
  message     String
  ctaLabel    String    @default("")
  ctaUrl      String    @default("")
  /// Show as a banner on the site while live.
  showBanner  Boolean   @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  isActive    Boolean   @default(false)
  emailSentAt DateTime?
  emailSentTo Int       @default(0)
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, startsAt])
}

/// A paid or house ad in a named slot on the site.
model AdPlacement {
  id          String    @id @default(cuid())
  /// "HOME_BANNER" | "DIRECTORY_TOP" | "STOREFRONT_FOOTER".
  slot        String
  title       String
  subtitle    String    @default("")
  imageUrl    String    @default("")
  imageFileId String    @default("")
  linkUrl     String    @default("")
  /// Who the ad is for — shown to admins, never to visitors.
  advertiser  String    @default("")
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  /// Higher shows first when a slot has several live ads.
  priority    Int       @default(0)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slot, isActive])
}

/// Every admin action, for accountability.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  /// e.g. "vendor.approve", "account.suspend", "category.update".
  action     String
  targetType String
  targetId   String   @default("")
  summary    String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// A discount code customers enter at checkout. GLAMNET-funded: it comes out
/// of the platform's share of a booking, never the vendor's payout.
model PromoCode {
  id               String    @id @default(cuid())
  /// Upper-case, letters/numbers/dashes. What the customer types.
  code             String    @unique
  description      String    @default("")
  /// "PERCENT" (value in basis points) or "FIXED" (value in pence).
  discountType     String    @default("PERCENT")
  value            Int
  /// Largest discount one booking can get, in pence. 0 = no cap beyond
  /// GLAMNET's share of the booking.
  maxDiscountMinor Int       @default(0)
  /// Services subtotal a basket must reach, in pence.
  minSpendMinor    Int       @default(0)
  /// Only a customer's first ever booking on GLAMNET.
  firstBookingOnly Boolean   @default(false)
  /// Empty = any category; otherwise the category name the basket must include.
  category         String    @default("")
  /// Total redemptions allowed across everyone. 0 = unlimited.
  maxRedemptions   Int       @default(0)
  /// Redemptions allowed per customer. 0 = unlimited.
  perCustomerLimit Int       @default(1)
  startsAt         DateTime  @default(now())
  endsAt           DateTime?
  isActive         Boolean   @default(true)
  createdBy        String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookings    Booking[]
  redemptions PromoRedemption[]
}

/// One use of a code. Counts only while its booking is still live.
model PromoRedemption {
  id            String    @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  /// One code per booking.
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId    String
  discountMinor Int
  createdAt     DateTime  @default(now())

  @@index([promoCodeId])
  @@index([customerId, promoCodeId])
}

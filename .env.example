# Pooled connection — used by the app on every request.
# On a serverless host each request can be its own lambda, so a direct
# connection per request would exhaust Postgres. Supabase: port 6543
# (?pgbouncer=true). Neon/Vercel Postgres: the "pooled" string.
#
# connection_limit is deliberately NOT 1. A single connection serialises every
# transaction in an instance, so two providers accepting the same booking at
# once made the second fail to start a transaction at all (Prisma P2028) —
# observed in production. 5 leaves room for a contended accept to queue.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=15"

# Direct, unpooled connection — used only by `prisma migrate`, which a
# transaction pooler cannot carry. Supabase: port 5432.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth --------------------------------------------------------
# Identity only. The publishable key is safe in the browser: it grants no
# database access on its own, and every table is reached through Prisma on
# the server, never through PostgREST.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Comma-separated emails granted the ADMIN role on first sign-in.
# Anything not listed here can never self-assign admin.
ADMIN_EMAILS="you@example.com"

# Canonical public origin. Set this to the live domain in production so
# canonical links, Open Graph images and the sitemap are absolute.
# Falls back to the Vercel deployment hostname when unset.
NEXT_PUBLIC_SITE_URL="https://glamnetapp.com"

# --- ImageKit (media library) ---------------------------------------------
# Delivery endpoint and public key are safe in the browser. The private key
# signs upload tokens and must stay server-side — it is the only thing
# preventing writes to the media library.
# Leave all three unset to disable image uploads; the app degrades to the
# brand's metal gradient rather than failing.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_..."
IMAGEKIT_PRIVATE_KEY="private_..."

# --- Resend (transactional email) -----------------------------------------
# Delivers the booking broadcast, the customer's confirmation and the provider
# vetting decision. Leave RESEND_API_KEY unset to disable email entirely — the
# app still records every notification, it just doesn't post them.
#
# RESEND_FROM must be an address on a domain verified in Resend. Resend's
# sandbox sender (onboarding@resend.dev) only ever delivers to the account
# owner's own address, so it is a smoke test, not a production setting.
RESEND_API_KEY="re_..."
RESEND_FROM="GLAMNET <bookings@glamnetapp.com>"

# --- Stripe Connect (card holds and vendor payouts) -----------------------
# Leave both unset to run the simulated gateway: every card hold "succeeds"
# instantly, no money moves, and booking pages say "test mode". Set both to
# take real pre-authorisation holds and pay vendors through Connect Express.
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# --- Cron ------------------------------------------------------------------
# Vercel Cron sends this as a bearer token to /api/cron/settlements, which
# marks bookings past their 24-hour dispute window as closed_uncontestable.
CRON_SECRET="a-long-random-string"
